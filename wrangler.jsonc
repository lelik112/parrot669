{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parrot669",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "env": {
    "regression-a": {
      "workers_dev": true,
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      }
    },
    "regression-b": {
      "workers_dev": true,
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      }
    }
  }
}
